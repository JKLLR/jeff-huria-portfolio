<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or 'Jeff .K. Huria — Technology Builder. Software engineer, ERP integration specialist, and AI-native founder building, connecting, and scaling systems, products, and businesses from Nairobi, Kenya.' }}">
    <title>{{ title or 'JEFF .K. HURIA — Technology Builder' }}</title>

    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title or 'JEFF .K. HURIA — Technology Builder' }}">
    <meta property="og:description" content="{{ description or 'Jeff .K. Huria — Technology Builder. Software engineer, ERP integration specialist, and AI-native founder building, connecting, and scaling systems, products, and businesses from Nairobi, Kenya.' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ site.image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or 'JEFF .K. HURIA — Technology Builder' }}">
    <meta name="twitter:description" content="{{ description or 'Jeff .K. Huria — Technology Builder. Software engineer, ERP integration specialist, and AI-native founder building, connecting, and scaling systems, products, and businesses from Nairobi, Kenya.' }}">
    <meta name="twitter:image" content="{{ site.url }}{{ site.image }}">

    <script>document.documentElement.classList.add('js');</script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Custom cursor (decorative) -->
    <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

    <!-- ===== LOADING SCREEN ===== -->
    {% include "partials/loader.njk" %}

    <!-- ===== MAIN SITE ===== -->
    <div class="site" id="site">

        {% include "partials/header.njk" %}

        <main id="main">
            {{ content | safe }}
        </main>

        {% include "partials/footer.njk" %}

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.3/dist/lenis.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/matter-js@0.19.0/build/matter.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
