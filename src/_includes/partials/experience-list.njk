{% macro experienceList(items) %}
<div class="experience-list">
    {% for item in items %}
    <div class="exp-item">
        <span class="exp-num">{{ "0" if loop.index < 10 else "" }}{{ loop.index }}</span>
        <div class="exp-content">
            <div class="exp-head">
                <h3>{{ item.role }}</h3>
                <span class="exp-company">{{ item.company }}</span>
                {% if item.current %}<span class="exp-current">CURRENT</span>{% endif %}
            </div>
            <p>{{ item.summary }}</p>
            {% if item.responsibilities | length %}
            <ul class="exp-resp">
                {% for responsibility in item.responsibilities %}
                <li>{{ responsibility }}</li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if item.achievements | length %}
            <ul class="exp-ach">
                {% for achievement in item.achievements %}
                <li>{{ achievement }}</li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if item.systems | length %}
            <p class="exp-systems">{{ item.systems | join(" · ") }}</p>
            {% endif %}
        </div>
        <span class="exp-dates">{{ item.startDate | dateRange(item.endDate) }}</span>
    </div>
    {% endfor %}
</div>
{% endmacro %}
