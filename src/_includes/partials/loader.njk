{#- The site's only loading screen. A band of churning records; as the load progresses the cells
    inside the letters of a word lock one by one until the word stands, made of data. The word is
    where you are going: the name on the home page, the project or capability title elsewhere, so a
    click on KODIWA starts spelling KODIWA before the page has even been requested.
    It is drawn by the inline script below (not main.js) so it is alive from the first paint, by one
    WebGL shader: the per-cell work is on the GPU, so a frame costs the main thread next to nothing. -#}
<div class="loader" id="loader" aria-hidden="true">
    {#- ragged data edges: records hanging off the sheet as it sweeps over the page (drawn by datafield.js) -#}
    <canvas class="loader-edge is-top"></canvas>
    <canvas class="loader-edge is-bottom"></canvas>
    <div class="loader-stage"><canvas class="loader-field" id="loaderField"></canvas></div>
    <div class="loader-pct"><span class="loader-dest" id="loaderDest"></span><span><span id="loaderPct">0</span>%</span></div>
</div>
<script>
(function () {
    var WORDS = { '/': 'JEFF K. HURIA', '/thanks/': 'THANK YOU' };
{%- for p in projectPages %}
    WORDS['/work/{{ p.slug }}/'] = {{ p.title | upper | dump | safe }};
{%- endfor %}
{%- for c in publishedCapabilities %}
    WORDS['/capabilities/{{ c.slug }}/'] = {{ c.title | upper | dump | safe }};
{%- endfor %}
    var CHARSET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-·.,:/+';
    // the stream is made of the systems actually worked with (src/_data/records.js)
    var REC = {{ records | dump | safe }};
    var POOLS = [REC.erps, REC.erps, REC.payments, REC.access, REC.messaging, REC.services].filter(function (l) { return l && l.length; });
    var STATUS = ['SYNC OK', 'POSTED', '200 OK', 'ACK', 'MATCHED', 'RECONCILED'];
    function pick(l) { return l[(Math.random() * l.length) | 0]; }
    function logLine(n) { // e.g. "SAP B1 · POSTED   M-PESA DARAJA · ACK   SYSPRO · SYNC OK"
        var s = '';
        while (s.length < n) s += (POOLS.length ? pick(pick(POOLS)) : 'SYNC') + ' · ' + pick(STATUS) + '   ';
        var cut = (Math.random() * 20) | 0;
        return (s + s).slice(cut, cut + n);
    }
    var canvas = document.getElementById('loaderField');
    var destEl = document.getElementById('loaderDest');
    // no field without motion (the CSS hides the loader then), and nothing left running behind the page
    if (!canvas || (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) return;

    // ── The renderer.
    // One full-screen triangle; each pixel finds its grid cell, reads that cell's state (inside the word?
    // which letter? how near?) from a tiny texture and picks a glyph from the atlas. All the per-cell
    // logic is in the shader, so a frame costs the main thread nothing.
    function Renderer(canvas, NGLYPH, report) {
        var gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: false, powerPreference: 'low-power' });
        if (!gl) return null;
        var VS = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
        var FS = [
            'precision mediump float;',
            'uniform sampler2D uState,uAtlas;uniform vec2 uGrid,uCell,uRes,uAG;uniform float uP,uOut,uFlash,uTime;',
            'float hash(vec2 p,float k){vec3 q=fract(vec3(p.xyx+k*17.13)*.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}',
            'float glyph(float i,vec2 f){vec2 a=vec2(mod(i,uAG.x),floor(i/uAG.x));return texture2D(uAtlas,(a+f)/uAG).a;}',
            'void main(){',
            ' vec2 px=vec2(gl_FragCoord.x,uRes.y-gl_FragCoord.y);vec2 cell=floor(px/uCell);',
            ' if(cell.x>=uGrid.x||cell.y>=uGrid.y){gl_FragColor=vec4(0.);return;}',
            ' vec4 st=texture2D(uState,(cell+.5)/uGrid);vec2 f=fract(px/uCell);',
            ' float tick=floor(uTime*14.);',
            ' float rnd=floor(hash(cell+vec2(tick*13.1,tick*7.7),5.)*' + NGLYPH + '.);',
            ' float flick=hash(cell+vec2(tick*3.3,tick*11.9),6.);',
            ' float h=hash(cell,1.),h2=hash(cell,2.),h3=hash(cell,3.);',
            ' float noise=1.-smoothstep(.35,1.,uP);vec3 ink=vec3(.067);vec3 paper=vec3(.965,.965,.957);',
            ' vec4 c=vec4(0.);float a;',
            ' if(st.r>.5){',
            '  float at=.04+h*.9,go=h2*.85+.1,letter=floor(st.g*255.+.5);',
            '  if(uOut>go){}',
            '  else if(uP>=at){',
            '   if(uOut>go-.1){a=.9*glyph(rnd,f);c=vec4(ink*a,a);}',
            '   else if(at>uP-uFlash){float g=glyph(letter,f);c=vec4(mix(ink,paper,g),1.);}',
            '   else{a=.07+.93*glyph(letter,f);c=vec4(ink*a,a);}',
            '  }else if(h3<.75){a=(.2+.2*flick)*glyph(rnd,f);c=vec4(ink*a,a);}',
            ' }else if(st.b>0.){',
            // the stream: each row is a line of sync log (alpha channel) sliding past at its own speed
            '  float sp=(hash(vec2(cell.y,9.),4.)*2.-1.)*3.;float sx=mod(cell.x+floor(uTime*sp),uGrid.x);',
            '  float rc=floor(texture2D(uState,(vec2(sx,cell.y)+.5)/uGrid).a*255.+.5);',
            '  if(rc<250.&&hash(vec2(sx,cell.y),3.)<(.62*noise+.1)*st.b&&flick<=.9){',
            '   a=(.08+.2*st.b)*(.35+.65*noise)*(1.-uOut)*glyph(flick>.84?rnd:rc,f);c=vec4(ink*a,a);}}',
            ' gl_FragColor=c;}',
        ].join('\n');
        // cell states, top to bottom: letting go → landing (inverted) → landed (on a faint tile) →
        // still searching (dim random records); outside the word, the stream thins as the word resolves
        function sh(t, src) { var o = gl.createShader(t); gl.shaderSource(o, src); gl.compileShader(o); return o; }
        var pr = gl.createProgram();
        gl.attachShader(pr, sh(gl.VERTEX_SHADER, VS)); gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, FS));
        gl.bindAttribLocation(pr, 0, 'a');
        gl.linkProgram(pr);
        if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return null;
        gl.useProgram(pr);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
        var U = {};
        ['uState', 'uAtlas', 'uGrid', 'uCell', 'uRes', 'uAG', 'uP', 'uOut', 'uFlash', 'uTime'].forEach(function (n) { U[n] = gl.getUniformLocation(pr, n); });
        function tex(unit) {
            var t = gl.createTexture(); gl.activeTexture(gl.TEXTURE0 + unit); gl.bindTexture(gl.TEXTURE_2D, t);
            var filt = unit ? gl.LINEAR : gl.NEAREST;
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filt); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filt);
            return t;
        }
        var tState = tex(0), tAtlas = tex(1);
        gl.uniform1i(U.uState, 0); gl.uniform1i(U.uAtlas, 1);

        var target = 0, p = 0, out = 0, vel = 0, running = false, last = 0, hasLayout = false, hasAtlas = false, frames = 0;
        var raf = typeof requestAnimationFrame === 'function'
            ? function (f) { return requestAnimationFrame(f); }
            : function (f) { return setTimeout(function () { f(performance.now()); }, 16); };
        function frame(now) {
            if (!running) return;
            var dt = last ? Math.min(0.1, (now - last) / 1000) : 0.016; last = now;
            var prev = p;
            p += (target - p) * Math.min(1, dt * 14); // glides over any hitch in the progress messages
            if (Math.abs(target - p) < 0.0005) p = target;
            vel += (Math.abs(p - prev) / Math.max(dt, 0.001) - vel) * Math.min(1, dt * 8);
            if (hasLayout && hasAtlas) {
                gl.uniform1f(U.uP, p); gl.uniform1f(U.uOut, out); gl.uniform1f(U.uTime, now / 1000);
                gl.uniform1f(U.uFlash, Math.min(0.05, vel * 0.16)); // a landing flash lasts ~0.16s, and none while stalled
                gl.drawArrays(gl.TRIANGLES, 0, 3);
                if (++frames === 1) report({ t: 'drawn' });
            }
            raf(frame);
        }
        return {
            msg: function (m) {
                if (m.t === 'layout') {
                    canvas.width = m.W; canvas.height = m.H;
                    gl.viewport(0, 0, m.W, m.H);
                    gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, tState);
                    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
                    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, m.cols, m.rows, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array(m.state));
                    gl.uniform2f(U.uGrid, m.cols, m.rows); gl.uniform2f(U.uCell, m.cw, m.ch); gl.uniform2f(U.uRes, m.W, m.H);
                    hasLayout = true;
                } else if (m.t === 'atlas') {
                    gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, tAtlas);
                    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, m.img);
                    gl.uniform2f(U.uAG, m.ac, m.ar);
                    hasAtlas = true;
                } else if (m.t === 'p') { target = m.v; if (m.snap) p = m.v; }
                else if (m.t === 'out') out = m.v;
                else if (m.t === 'run') { if (!running) { running = true; last = 0; raf(frame); } }
                else if (m.t === 'stop') running = false;
                else if (m.t === 'stats') report({ t: 'stats', frames: frames });
            },
        };
    }

    // ── The renderer draws from this thread. A frame costs it a fraction of a millisecond, and it is ready
    // on the first paint. (A worker with an OffscreenCanvas was tried: its first frame arrived only after
    // the page had booted, so on a slow load the word appeared already finished, and Chrome let the page
    // show through the sheet until then.)
    var S = { p: 0, word: '', path: '', running: false }, fontReady = false, cw, ch, dpr, statsCb = null;
    function report(m) {
        if (m.t === 'drawn') canvas.dataset.firstFrame = Math.round(performance.now());
        else if (m.t === 'stats' && statsCb) statsCb(m);
    }
    var R = Renderer(canvas, CHARSET.length, report);
    if (!R) return;
    var post = function (m) { R.msg(m); };

    function wordFor(path) { return WORDS[path] || WORDS[path + '/'] || 'JEFF K. HURIA'; }
    function fit(o, lines, fam, W, H) {
        o.font = '800 100px ' + fam;
        var wmax = 0;
        for (var i = 0; i < lines.length; i++) wmax = Math.max(wmax, o.measureText(lines[i]).width);
        return Math.min(100 * (W * 0.88) / wmax, (H * 0.42) / (lines.length * 0.86));
    }

    // Lay the word out to the screen and record, per grid cell, whether it falls inside a letter.
    // Runs once per word / size / font, never per frame.
    function layout() {
        var W = innerWidth, H = innerHeight;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        cw = Math.max(5, Math.min(10, Math.round(W / 180)));
        ch = Math.round(cw * 1.3);
        var cols = Math.ceil(W / cw), rows = Math.ceil(H / ch);
        var off = document.createElement('canvas'), k = 0.5;
        off.width = Math.ceil(W * k); off.height = Math.ceil(H * k);
        var o = off.getContext('2d', { willReadFrequently: true });
        var fam = fontReady ? '"Sofia Sans Condensed", "Arial Narrow", sans-serif' : '"Arial Narrow", sans-serif';
        var lines = [S.word], size = fit(o, lines, fam, W, H);
        if (S.word.indexOf(' ') > 0 && size < H * 0.16) { // long titles on a narrow screen read better on two lines
            var ws = S.word.split(' '), best = null;
            for (var i = 1; i < ws.length; i++) {
                var l2 = [ws.slice(0, i).join(' '), ws.slice(i).join(' ')], s2 = fit(o, l2, fam, W, H);
                if (!best || s2 > best.s) best = { l: l2, s: s2 };
            }
            if (best && best.s > size * 1.15) { lines = best.l; size = best.s; }
        }
        var lh = size * 0.86, total = lh * lines.length, top = H / 2 - total / 2, bot = H / 2 + total / 2;
        o.setTransform(k, 0, 0, k, 0, 0);
        o.textAlign = 'center'; o.textBaseline = 'alphabetic'; o.font = '800 ' + size + 'px ' + fam;
        // Each line is centred on its capitals and clipped to them, so tails (the J of JEFF, a comma)
        // don't hang under the word: it reads as one clean block of records
        var cap = o.measureText('H').actualBoundingBoxAscent || size * 0.7;
        for (var n = 0; n < lines.length; n++) {
            var base = top + lh * (n + 0.5) + cap / 2;
            o.save(); o.beginPath(); o.rect(0, base - cap - 1, W, cap + 1); o.clip();
            o.fillText(lines[n], W / 2, base);
            o.restore();
        }
        var img = o.getImageData(0, 0, off.width, off.height).data;
        var name = S.word.replace(/[^A-Z0-9]/g, '') || 'JKH', seq = 0, line;
        var state = new Uint8Array(cols * rows * 4);
        for (var r = 0; r < rows; r++) {
            line = logLine(cols);
            var y = (r + 0.5) * ch, dist = y > top && y < bot ? 0 : Math.min(Math.abs(y - top), Math.abs(y - bot)) / ch;
            var fall = Math.max(0, 1 - dist / 9);
            for (var c = 0; c < cols; c++) {
                var x = (c + 0.5) * cw, i4 = (r * cols + c) * 4;
                var inside = (img[(Math.floor(y * k) * off.width + Math.floor(x * k)) * 4 + 3] || 0) > 110;
                state[i4] = inside ? 255 : 0;
                state[i4 + 1] = inside ? CHARSET.indexOf(name[seq++ % name.length]) : 0;
                state[i4 + 2] = Math.round((inside ? 1 : fall) * 255);
                var li = CHARSET.indexOf(line[c]);
                state[i4 + 3] = li < 0 ? 255 : li;   // 255: a gap between records
            }
        }
        post({ t: 'layout', W: Math.round(W * dpr), H: Math.round(H * dpr), cols: cols, rows: rows, cw: cw * dpr, ch: ch * dpr, state: state.buffer });
        atlas();
    }

    // White glyphs on transparent, one per grid cell at the cell's exact device size
    function atlas() {
        var ac = 8, ar = Math.ceil(CHARSET.length / ac), w = Math.round(cw * dpr), h = Math.round(ch * dpr);
        var c = document.createElement('canvas'); c.width = ac * w; c.height = ar * h;
        var o = c.getContext('2d');
        o.fillStyle = '#fff'; o.textAlign = 'center'; o.textBaseline = 'middle';
        o.font = '500 ' + Math.round(cw * 1.5 * dpr) + 'px "Spline Sans Mono", ui-monospace, monospace';
        for (var i = 0; i < CHARSET.length; i++) o.fillText(CHARSET[i], (i % ac) * w + w / 2, ((i / ac) | 0) * h + h / 2);
        post({ t: 'atlas', img: c, ac: ac, ar: ar });
    }

    var L = window.jkhLoader = {
        get p() { return S.p * 100; },
        set: function (v) { S.p = Math.max(0, Math.min(1, v / 100)); post({ t: 'p', v: S.p }); },
        release: function (v) { post({ t: 'out', v: v }); },
        start: function (path) {
            S.path = path || location.pathname;
            if (destEl) destEl.textContent = S.path;
            S.p = 0; post({ t: 'p', v: 0, snap: true }); post({ t: 'out', v: 0 });
            var w = wordFor(S.path);
            if (w !== S.word) { S.word = w; layout(); }
            S.running = true; post({ t: 'run' });
        },
        stop: function () { S.running = false; post({ t: 'stop' }); },
        // frames drawn so far (for performance checks)
        stats: function (cb) { statsCb = cb; post({ t: 'stats' }); },
        // handed to the next page so the word keeps forming across the navigation
        carry: function () {
            try { sessionStorage.setItem('jkh-loader', JSON.stringify({ path: S.path, p: S.p, t: Date.now() })); } catch (e) {}
        },
    };

    L.start(location.pathname);
    try {
        var cy = JSON.parse(sessionStorage.getItem('jkh-loader') || 'null');
        sessionStorage.removeItem('jkh-loader');
        if (cy && cy.path === location.pathname && Date.now() - cy.t < 5000) {
            S.p = cy.p; post({ t: 'p', v: cy.p, snap: true });
            var pc = document.getElementById('loaderPct'); if (pc) pc.textContent = Math.round(cy.p * 100);
        }
    } catch (e) {}
    var rebuild = function () { if (S.word) layout(); };
    if (document.fonts && document.fonts.load) {
        Promise.race([
            Promise.all([document.fonts.load('800 100px "Sofia Sans Condensed"'), document.fonts.load('500 12px "Spline Sans Mono"')]),
            new Promise(function (r) { setTimeout(r, 2500); }),
        ]).then(function () { fontReady = true; rebuild(); });
    } else fontReady = true;
    var rt; addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(rebuild, 120); });
})();
</script>
