{% macro worksGrid(items) %}
<div class="works-grid">
    {% for item in items %}
    <article class="work-item">
        <div class="work-meta">
            <span class="work-num">{{ "0" if loop.index < 10 else "" }}{{ loop.index }}</span>
            <span class="work-type">{{ item.type | replace("-", " ") }}</span>
            {% if item.status == "offline" %}<span class="work-status">OFFLINE</span>{% endif %}
        </div>
        <div class="work-img">
            {% if item.image %}
            <div class="work-img-inner">
                <img src="{{ item.image.src }}" alt="{{ item.image.alt }}" width="1440" height="900" loading="lazy" decoding="async">
            </div>
            {% else %}
            <div class="work-img-inner work-img-type" aria-hidden="true">
                <span class="work-img-word">{{ item.title }}</span>
            </div>
            {% endif %}
        </div>
        <div class="work-info">
            <h3 class="work-title">{{ item.title }}</h3>
            {% if item.role | length %}
            <p class="work-role">{{ item.role | join(" · ") }}</p>
            {% endif %}
            {% if item.shortDescription %}
            <p class="work-desc">{{ item.shortDescription }}</p>
            {% endif %}
            {% if item.highlights | length %}
            <ul class="work-highlights">
                {% for highlight in item.highlights %}
                <li>{{ highlight }}</li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if item.technologies | length %}
            <p class="work-tags">{{ item.technologies | join(" / ") }}</p>
            {% endif %}
            {% if item.links and item.links.website %}
            <a href="{{ item.links.website }}" target="_blank" rel="noopener" class="work-link">VISIT SITE ↗<span class="visually-hidden"> — {{ item.title }} (opens in a new tab)</span></a>
            {% endif %}
        </div>
    </article>
    {% endfor %}
</div>
{% endmacro %}
