{% macro worksGrid(items) %}
<div class="works-grid">
    {% for item in items %}
    <div class="work-item">
        <div class="work-num">{{ "0" if loop.index < 10 else "" }}{{ loop.index }}</div>
        <div class="work-img">
            <div class="work-img-inner"></div>
        </div>
        <div class="work-info">
            <h3 class="work-title">{{ item.title }}</h3>
            {% if item.technologies | length %}
            <p class="work-tags">{{ item.technologies | join(" / ") }}</p>
            {% endif %}
            {% if item.links and item.links.visit %}
            <a href="{{ item.links.visit.href }}"{% if item.links.visit.external %} target="_blank" rel="noopener"{% endif %} class="work-link">{{ item.links.visit.label }}</a>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endmacro %}
