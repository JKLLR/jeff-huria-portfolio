---
layout: layouts/base.njk
pagination:
  data: publishedCapabilities
  size: 1
  alias: cap
permalink: /capabilities/{{ cap.slug }}/index.html
eleventyComputed:
  title: "{{ cap.title }} — JEFF .K. HURIA"
  description: "{{ cap.summary }}"
---
{% from "partials/works-grid.njk" import worksGrid %}
{% from "partials/experience-list.njk" import experienceList %}
{% set capProjects = projects | byCapability(cap.slug) %}
{% set capExperience = experience | byCapability(cap.slug) %}

<section class="section capability-hero">
    <div class="section-label">[ CAPABILITY ]</div>
    <h1 class="section-title">{{ cap.title }}</h1>
    <p class="capability-tagline">{{ cap.tagline }}</p>
</section>

<section class="section capability-description">
    {% for para in cap.description %}
    <p>{{ para }}</p>
    {% endfor %}
</section>

{% if cap.competencies | length %}
<section class="section capability-competencies">
    <div class="section-label">[ APPROACH ]</div>
    <h2 class="section-title">HOW I<br>WORK</h2>
    <ul class="cap-comp-list">
        {% for competency in cap.competencies %}
        <li>{{ competency }}</li>
        {% endfor %}
    </ul>
</section>
{% endif %}

{% if capExperience | length %}
<section class="section capability-evidence" id="experience">
    <div class="section-label">[ EVIDENCE — EXPERIENCE ]</div>
    <h2 class="section-title">WHERE IT<br>SHOWS UP</h2>
    {{ experienceList(capExperience) }}
</section>
{% endif %}

{% if capProjects | length %}
<section class="section capability-evidence" id="works">
    <div class="section-label">[ EVIDENCE — PROJECTS ]</div>
    <h2 class="section-title">WHAT I'VE<br>SHIPPED</h2>
    {{ worksGrid(capProjects) }}
</section>
{% endif %}
